# ==========================================================
# NEXORA AI — Public Standalone Node.js Server Configuration
# ==========================================================
# Never commit a real .env file with API keys. Set these in
# your hosting provider (e.g. Abasthan) Environment Variables.

# Server runtime & port (Abasthan injects PORT automatically; defaults to 3000 locally)
NODE_ENV=production
PORT=3000

# Public HTTPS URL where NEXORA AI is hosted (e.g. https://nexora.your-domain.com)
PUBLIC_APP_URL=
APP_URL=

# Optional comma-separated extra allowed origins for CORS (same-origin & Android WebView are built in)
CORS_ALLOWED_ORIGINS=

# Primary AI Provider Key (server-side only; never exposed to browser or APK)
GEMINI_API_KEY=

# Optional alternative AI provider keys (server-side only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=

# Admin Passcode for the protected System Admin Console & internal Knowledge Base.
# IMPORTANT: Set a strong passcode in production before sharing publicly!
NEXORA_ADMIN_PASSCODE=

# Optional persistent HMAC secret for admin tokens (recommended on production hosts)
SESSION_SECRET=

# Persistent SQLite database path (mount a persistent disk at /data on Abasthan if available)
NEXORA_DB_PATH=./data/nexora.db

# Optional workspace directory for the sandboxed File Manager
NEXORA_WORKSPACE_DIR=./workspace

# Public GitHub repository slug (e.g. owner/nexora-ai) for Android APK release resolution
NEXORA_GITHUB_REPO=

# Optional direct HTTPS URL to a published Android APK release
NEXORA_APK_RELEASE_URL=
